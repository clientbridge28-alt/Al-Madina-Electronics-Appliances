# GEMINI_API_KEY: Required if Gemini AI features are enabled server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet / backend is hosted.
APP_URL="MY_APP_URL"

# PORT: Express HTTP server port (defaults to 3000 in AI Studio / Cloud Run).
PORT="3000"

# VITE_BASE: Base path override (defaults to /Al-Madina-Electronics-Appliances/ in production builds)
VITE_BASE="/Al-Madina-Electronics-Appliances/"

# VITE_API_BASE_URL: Companion Express/Cloud Run backend URL when frontend is served statically on GitHub Pages
VITE_API_BASE_URL=""

# FRONTEND FIREBASE CLIENT CONFIGURATION (Public Web SDK keys; optional override over firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# OWNER_ALERT_EMAIL: Owner security notification recipient
OWNER_ALERT_EMAIL="clientbridge28@gmail.com"

# SMTP EMAIL CONFIGURATION (Backend only — never prefix with VITE_)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Al-Madina ERP Security <no-reply@almadinaelectronics.pk>"

# WORDPRESS / WOOCOMMERCE SERVER-SIDE INTEGRATION (Backend only — never prefix with VITE_)
WP_SITE_URL=""
WP_REST_USERNAME=""
WP_APP_PASSWORD=""
WP_WC_KEY=""
WP_WC_SECRET=""
