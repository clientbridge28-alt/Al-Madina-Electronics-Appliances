# GEMINI_API_KEY: Required if Gemini AI features are enabled server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Express HTTP server port (defaults to 3000 in AI Studio).
PORT="3000"

# VITE_BASE: Base path override (defaults to /Al-Madina-Electronics-Appliances/ in production builds)
VITE_BASE="/Al-Madina-Electronics-Appliances/"

# VITE_API_BASE_URL: Optional backend API URL when frontend is served statically (e.g. GitHub Pages -> Cloud Run URL)
VITE_API_BASE_URL=""

# OWNER_ALERT_EMAIL: Owner security notification recipient
OWNER_ALERT_EMAIL="clientbridge28@gmail.com"

# SMTP EMAIL CONFIGURATION (For Owner Security Alerts, MFA OTPs, and Staff Notifications)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Al-Madina ERP Security <no-reply@almadinaelectronics.pk>"

# WORDPRESS / WOOCOMMERCE SERVER-SIDE INTEGRATION (Never expose these in frontend VITE_* variables)
WP_SITE_URL=""
WP_REST_USERNAME=""
WP_APP_PASSWORD=""
WP_WC_KEY=""
WP_WC_SECRET=""
